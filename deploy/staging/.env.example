# Copy this file to deploy/staging/.env on the staging server.
#
# Required public API domain. Point its DNS A record to the server public IP
# before starting Caddy, for example:
# ORBI_API_DOMAIN=api-staging.orbi.example
ORBI_API_DOMAIN=api-staging.orbi.example
ORBI_ADMIN_DOMAIN=admin-staging.orbi.example

POSTGRES_DB=orbi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-long-random-password

# Backend runtime
FRONTEND_ALLOWED_ORIGINS=https://admin-staging.orbi.example
PAYMENTS_WEBHOOK_SECRET=change-this-long-random-secret
DOCUMENT_SIGNING_SECRET=change-this-long-random-secret
MOBILE_ERROR_COLLECTOR_TIMEOUT_MS=1500

# Keep payments manual/test during the first closed field pilot.
PAYMENTS_PROVIDER=flutterwave
PAYMENTS_REFUND_MODE=manual
PAYMENTS_CURRENCY=XOF
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=
