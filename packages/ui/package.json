{
  "name": "@orbi/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./native": {
      "types": "./src/native.ts",
      "default": "./src/native.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-native": "*",
    "expo-haptics": "*"
  },
  "dependencies": {
    "@orbi/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit"
  }
}
