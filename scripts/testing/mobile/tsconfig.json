{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../../..",
    "jsx": "react-jsx",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "types": ["jest", "node", "react"],
    "typeRoots": [
      "../../../apps/rider-app/node_modules/@types",
      "../../../apps/backend/node_modules/@types"
    ],
    "paths": {
      "react": ["apps/rider-app/node_modules/react"],
      "react/*": ["apps/rider-app/node_modules/react/*"],
      "react-test-renderer": ["apps/rider-app/node_modules/react-test-renderer"],
      "react-test-renderer/*": [
        "apps/rider-app/node_modules/react-test-renderer/*"
      ]
    }
  },
  "include": ["./*.ts", "./*.tsx"]
}
