{
  "name": "orbi",
  "version": "1.0.0",
  "description": "Orbi monorepo for rider, driver, admin, and backend applications.",
  "private": true,
  "scripts": {
    "setup:local": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\bootstrap-local.ps1",
    "mobile:lan": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\set-mobile-lan-api.ps1",
    "mobile:check": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\testing\\mobile-field-readiness.ps1",
    "mobile:brand-assets": "node ./scripts/generate-mobile-brand-assets.mjs",
    "mobile:apk": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-apk-local.ps1 -App all",
    "mobile:apk:rider": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-apk-local.ps1 -App rider",
    "mobile:apk:driver": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-apk-local.ps1 -App driver",
    "mobile:field": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\eas-build-field.ps1",
    "field:api:check": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\testing\\check-public-field-api.ps1 -ApiUrl https://backend-production-d5d1.up.railway.app",
    "local:doctor": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\testing\\local-doctor.ps1",
    "local:ports:free": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\free-local-ports.ps1",
    "db:start": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-local-db.ps1",
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:admin": "pnpm --filter @orbi/admin-web dev",
    "dev:rider": "pnpm --filter @orbi/rider-app start",
    "dev:driver": "pnpm --filter @orbi/driver-app start",
    "dev:rider:web": "pnpm --filter @orbi/rider-app web",
    "dev:driver:web": "pnpm --filter @orbi/driver-app web",
    "build:android:rider:mvp": "pnpm --filter @orbi/rider-app build:android:mvp",
    "build:android:driver:mvp": "pnpm --filter @orbi/driver-app build:android:mvp",
    "dev:stack": "concurrently -n backend,admin,rider -c blue,green,magenta \"pnpm dev:backend\" \"pnpm dev:admin\" \"pnpm dev:rider\"",
    "dev:web-preview": "pnpm local:ports:free && concurrently -n backend,admin,rider-web -c blue,green,magenta \"pnpm dev:backend\" \"pnpm dev:admin\" \"pnpm dev:rider:web\"",
    "dev:web-driver-preview": "pnpm local:ports:free && concurrently -n backend,admin,driver-web -c blue,green,yellow \"pnpm dev:backend\" \"pnpm dev:admin\" \"pnpm dev:driver:web\"",
    "dev:full-web": "pnpm local:ports:free && concurrently -n backend,admin,rider-web -c blue,green,magenta \"pnpm dev:backend\" \"pnpm dev:admin\" \"pnpm dev:rider:web\"",
    "dev:full-mobile": "pnpm local:ports:free && concurrently -n backend,admin,rider,driver -c blue,green,magenta,yellow \"pnpm dev:backend\" \"pnpm dev:admin\" \"pnpm dev:rider\" \"pnpm dev:driver\"",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "typecheck": "pnpm --filter @orbi/domain build && pnpm --filter @orbi/api build && pnpm --filter @orbi/config build && pnpm --filter @orbi/ui build && pnpm --filter @orbi/admin-web typecheck && pnpm --filter @orbi/rider-app typecheck && pnpm --filter @orbi/driver-app typecheck && pnpm --filter backend build",
    "test:admin:smoke": "pnpm --filter @orbi/admin-web test:smoke",
    "test:mobile:helpers": "pnpm --filter @orbi/rider-app exec tsc -p ../../scripts/testing/mobile/tsconfig.json",
    "test:mobile:smoke": "pnpm --filter @orbi/rider-app test:smoke && pnpm --filter @orbi/driver-app test:smoke",
    "test:payments:fixtures": "pnpm --filter backend test -- payments.service.spec.ts --runInBand",
    "test:security:local": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\testing\\security-local-gate.ps1",
    "test:production:gate": "node ./scripts/testing/production-readiness-gate.mjs",
    "demo:local-live-session": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\testing\\local-demo-live-session.ps1",
    "e2e:local-checklist": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\testing\\local-e2e-field-session.ps1",
    "e2e:local-api": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\testing\\local-api-e2e-smoke.ps1",
    "test": "pnpm --filter backend test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:migrate": "pnpm --filter backend prisma:migrate",
    "prisma:migrate:dev": "pnpm --filter backend prisma:migrate:dev",
    "prisma:seed": "pnpm --filter backend prisma:seed"
  },
  "keywords": [
    "orbi",
    "ride-hailing",
    "monorepo",
    "nestjs",
    "expo",
    "nextjs"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.28",
      "@types/react-dom": "18.3.7",
      "lodash": "4.18.1",
      "source-map-js": "1.2.1",
      "handlebars": ">=4.7.9",
      "tar": ">=7.5.7",
      "serialize-javascript": ">=7.0.5",
      "picomatch": "4.0.4",
      "path-to-regexp": ">=8.4.0",
      "tinyglobby": "0.2.16",
      "fast-xml-parser": "5.8.0",
      "minipass-pipeline": "2.0.0",
      "brace-expansion@>=4.0.0 <5.0.5": "5.0.6",
      "defu": "6.1.7",
      "fast-uri": "3.1.2",
      "@xmldom/xmldom": "0.8.13",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.20.0",
      "multer": "2.1.1",
      "hono": "4.12.18",
      "@hono/node-server": "1.19.14",
      "effect": "3.21.2",
      "flatted": "3.4.2",
      "postcss": "8.5.14",
      "qs": "6.15.2",
      "uuid": "11.1.1",
      "ws": "8.20.1",
      "jest": "29.7.0",
      "babel-jest": "29.7.0",
      "ts-jest": "29.2.5",
      "@jest/transform": "29.7.0",
      "@jest/types": "29.6.3",
      "jest-util": "29.7.0",
      "lru-cache@>=10": "10.4.3",
      "@nestjs/common": "11.1.19",
      "@nestjs/core": "11.1.19",
      "@nestjs/platform-express": "11.1.19",
      "@nestjs/testing": "11.1.19",
      "@nestjs/mapped-types": "2.1.0"
    },
    "patchedDependencies": {
      "@nestjs/mapped-types@2.1.0": "patches/@nestjs__mapped-types@2.1.0.patch",
      "@nestjs/config@4.0.2": "patches/@nestjs__config@4.0.2.patch",
      "@nestjs/swagger@11.2.7": "patches/@nestjs__swagger@11.2.7.patch",
      "client-only@0.0.1": "patches/client-only@0.0.1.patch",
      "minimatch@9.0.7": "patches/minimatch@9.0.7.patch",
      "minimatch@10.2.5": "patches/minimatch@10.2.5.patch",
      "server-only@0.0.1": "patches/server-only@0.0.1.patch",
      "@expo/cli@0.22.28": "patches/@expo__cli@0.22.28.patch"
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "9.0.17",
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5"
  }
}
