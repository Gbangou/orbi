{
  "expo": {
    "name": "Orbi Chauffeur",
    "slug": "orbi-chauffeur",
    "scheme": "orbi-chauffeur",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orbi Chauffeur utilise votre position pour prioriser les offres proches et alimenter le dispatch en direct."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./icon.png",
          "color": "#F2A900",
          "defaultChannel": "default",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "../../plugins/with-expo-core-compat",
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Orbi Chauffeur utilise votre position pour prioriser les offres proches et alimenter le dispatch en direct.",
        "NSAllowsArbitraryLoads": false
      }
    },
    "android": {
      "package": "app.orbi.driver",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "usesCleartextTraffic": true,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#071311"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./favicon.png"
    },
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06100E"
    },
    "extra": {
      "eas": {
        "projectId": "2c84c3ed-6ce8-4819-be2e-cfacfe8e9665"
      }
    },
    "owner": "gbangou"
  }
}
