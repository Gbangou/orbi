{
  "expo": {
    "name": "Orbi Chauffeur",
    "slug": "orbi-chauffeur",
    "scheme": "orbi-chauffeur",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orbi Chauffeur utilise votre position pour prioriser les offres proches et alimenter le dispatch en direct.",
          "locationAlwaysAndWhenInUsePermission": "Orbi Chauffeur utilise votre position en arrière-plan pour garder votre statut en ligne et suivre vos courses même écran verrouillé.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./icon.png",
          "color": "#00A884",
          "defaultChannel": "default",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "../../plugins/with-expo-core-compat",
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Orbi Chauffeur utilise votre position pour prioriser les offres proches et alimenter le dispatch en direct.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Orbi Chauffeur utilise votre position en arrière-plan pour garder votre statut en ligne et suivre vos courses même écran verrouillé.",
        "UIBackgroundModes": ["location"],
        "NSAllowsArbitraryLoads": false
      }
    },
    "android": {
      "package": "app.orbi.driver",
      "versionCode": 2,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "usesCleartextTraffic": false,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#0B0B0B"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./favicon.png"
    },
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F2"
    },
    "extra": {
      "eas": {
        "projectId": "2c84c3ed-6ce8-4819-be2e-cfacfe8e9665"
      }
    },
    "owner": "gbangou"
  }
}
