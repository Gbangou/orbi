{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.14.0",
      "pnpm": "10.30.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000",
        "EXPO_PUBLIC_API_VERSION": "v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.14.0",
      "pnpm": "10.30.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_VERSION": "v1"
      }
    },
    "mvp": {
      "distribution": "internal",
      "channel": "mvp",
      "node": "22.14.0",
      "pnpm": "10.30.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_VERSION": "v1"
      }
    },
    "production": {
      "channel": "production",
      "node": "22.14.0",
      "pnpm": "10.30.0",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_VERSION": "v1"
      }
    }
  }
}
