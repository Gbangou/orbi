PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/orbi?schema=public
FRONTEND_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8081
TRUST_PROXY=false
ENABLE_SWAGGER=true
REQUEST_BODY_LIMIT=256kb
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
RATE_LIMIT_ADAPTER=in-memory
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_STRICT=false
REALTIME_ADAPTER=in-memory
REALTIME_REDIS_URL=
REALTIME_STRICT=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000
DRIVER_RESERVATION_EXPIRY_SWEEP_INTERVAL_MS=5000
DRIVER_RESERVATION_EXPIRY_MAX_SILENCE_MS=30000
HEALTH_WATCHDOG_INTERVAL_MS=15000
HEALTH_WATCHDOG_ALERT_COOLDOWN_MS=60000
HEALTH_INCIDENT_HISTORY_LIMIT=12
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DOCUMENT_SIGNING_SECRET=orbi_dev_document_secret
DOCUMENT_UPLOAD_BASE_URL=https://storage.orbi.local/upload
DOCUMENT_VIEW_BASE_URL=https://storage.orbi.local/view
DOCUMENT_LINK_TTL_SECONDS=900
DOCUMENT_OBJECT_PROVIDER=local-provider
DOCUMENT_LOCAL_PROVIDER_ROOT=.orbi-document-store
