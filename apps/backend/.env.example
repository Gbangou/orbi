OPERATIONS_CHAOS_DRAIN_DRILL_AT=
OPERATIONS_TERMS_VERSION=
OPERATIONS_PRIVACY_VERSION=
OPERATIONS_INSURANCE_POLICY_REF=
OPERATIONS_PILOT_MAX_CONCURRENT_TRIPS=0
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000
DRIVER_RESERVATION_EXPIRY_SWEEP_INTERVAL_MS=5000
DRIVER_RESERVATION_EXPIRY_MAX_SILENCE_MS=30000
PAYMENT_ATTEMPT_RECONCILIATION_SWEEP_INTERVAL_MS=120000
PAYMENT_ATTEMPT_RECONCILIATION_STALE_AFTER_MS=600000
PAYMENT_ATTEMPT_RECONCILIATION_BATCH_SIZE=25
HEALTH_WATCHDOG_INTERVAL_MS=15000
HEALTH_WATCHDOG_ALERT_COOLDOWN_MS=60000
HEALTH_INCIDENT_HISTORY_LIMIT=12
FEATURE_FLAG_PAYMENTS=on
FEATURE_FLAG_PAYMENTS_ALLOWLIST=
PAYMENTS_PROVIDER=pawapay
PAYMENTS_CURRENCY=XOF
PAYMENTS_WEBHOOK_SECRET=orbi_dev_webhook_secret
PAYMENTS_DEFAULT_REDIRECT_URL=http://localhost:8081/book
PAYMENTS_DEFAULT_WEBHOOK_URL=http://localhost:3000/api/v1/payments/webhooks
PAYMENTS_REFUND_MODE=manual
PAWAPAY_API_TOKEN=
PAWAPAY_WEBHOOK_SECRET=
PAWAPAY_ENVIRONMENT=sandbox
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
