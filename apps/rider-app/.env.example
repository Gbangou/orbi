# ─── Orbi Rider App — Variables d'environnement ───────────────────────────
# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais commiter .env.local (il est dans .gitignore).
#
# Pour les tests terrain (vrais telephones, donnees mobiles) :
#   EXPO_PUBLIC_API_BASE_URL doit pointer vers le backend deploy publiquement.
#   Exemple avec serveur deploye : https://api.monserveur.com
#   Exemple avec ngrok (test temporaire) : https://abc123.ngrok.io
#
# Pour les tests sur LAN (WiFi local) :
#   pnpm mobile:lan  →  detecre l'IP locale automatiquement
#
# Pour le dev local uniquement :
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_VERSION=v1
