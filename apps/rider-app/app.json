{
  "expo": {
    "name": "Orbi Passager",
    "slug": "orbi-passager",
    "scheme": "orbi-passager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orbi Passager utilise votre position pour definir le depart, partager les signaux securite et suivre la course active."
        }
      ],
      "expo-screen-capture"
    ],
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Orbi Passager utilise votre position pour definir le depart, partager les signaux securite et suivre la course active.",
        "NSAllowsArbitraryLoads": false
      }
    },
    "android": {
      "package": "app.orbi.rider",
      "versionCode": 1,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "usesCleartextTraffic": false,
      "allowBackup": false
    },
    "web": {
      "bundler": "metro"
    }
  }
}
